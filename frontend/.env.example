# Copie este arquivo para ".env" e preencha. Nunca suba o ".env" para o GitHub.

# Endereço do backend (sem barra no final)
VITE_API_URL=http://localhost:3000

# Login com Google (Firebase). Opcional: sem estes valores o botão do Google fica oculto.
# Pegue os valores em: Firebase Console > Configurações do projeto > Seus apps > Configuração do SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

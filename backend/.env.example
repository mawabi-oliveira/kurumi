# Copie este arquivo para ".env" e preencha os valores. Nunca suba o ".env" para o GitHub.

DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

HOST=localhost
PORT=3000

# Endereço do frontend permitido pelo CORS (deixe vazio em desenvolvimento para aceitar qualquer origem)
CORS_ORIGIN=

# Segredos obrigatórios: use textos longos e aleatórios, diferentes em cada ambiente.
# Gerar um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALT=troque-por-um-segredo-longo
JWT_PASS=troque-por-outro-segredo-longo
